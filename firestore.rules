rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCurrentSquadMember() {
      return signedIn() &&
        resource.data.memberIds is list &&
        resource.data.memberIds.hasAny([request.auth.uid]);
    }

    function currentUserSquadId() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.squadId
        : null;
    }

    function canAccessPleaData(pleaData) {
      return signedIn() &&
        (
          (pleaData.userId == request.auth.uid) ||
          (pleaData.visibleToUids is list &&
            pleaData.visibleToUids.hasAny([request.auth.uid]))
        );
    }

    function isMockPlea(pleaData) {
      return pleaData.isMockSession == true;
    }

    function isValidPleaMessageCreate(messageData) {
      return messageData.keys().hasOnly([
          'senderId',
          'senderName',
          'text',
          'timestamp',
          'isSystem',
        ]) &&
        messageData.senderId is string &&
        messageData.senderId == request.auth.uid &&
        messageData.senderName is string &&
        messageData.senderName.size() > 0 &&
        messageData.senderName.size() <= 64 &&
        messageData.text is string &&
        messageData.text.size() > 0 &&
        messageData.text.size() <= 400 &&
        messageData.timestamp is timestamp &&
        (!messageData.keys().hasAny(['isSystem']) ||
          messageData.isSystem == false);
    }

    function canMarkNotificationRead() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead']) &&
        request.resource.data.isRead is bool;
    }

    function canBootstrapOwnSquadId() {
      return resource.data.squadId == null &&
        request.resource.data.squadId is string &&
        getAfter(/databases/$(database)/documents/squads/$(request.resource.data.squadId)).data.memberIds is list &&
        getAfter(/databases/$(database)/documents/squads/$(request.resource.data.squadId)).data.memberIds.size() == 1 &&
        getAfter(/databases/$(database)/documents/squads/$(request.resource.data.squadId)).data.memberIds.hasAny([request.auth.uid]);
    }

    function canUpdateOwnUserDoc(userId) {
      return isSelf(userId) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['squadId']) ||
          request.resource.data.squadId == null ||
          canBootstrapOwnSquadId()
        );
    }

    function squadHasNoMembers() {
      return !(resource.data.memberIds is list) || resource.data.memberIds.size() == 0;
    }

    // User profiles
    match /users/{userId} {
      // Full profiles are private. Circle members read sanitized summaries
      // under squads/{circleId}/members instead.
      allow read: if isAdmin() || isSelf(userId);

      // Own profile management (create/update/delete account doc)
      allow create: if isAdmin() || isSelf(userId);
      allow update: if isAdmin() || canUpdateOwnUserDoc(userId);
      allow delete: if isAdmin() || isSelf(userId);

      // Cloud-synced regimes live under the user's document.
      match /regimes/{regimeId} {
        allow read: if isAdmin() ||
          isSelf(userId);
        allow write: if isAdmin() || isSelf(userId);
      }

      // Local-first taper plans sync only to the owning user's namespace.
      match /taperPlans/{planId} {
        allow read, write: if isAdmin() || isSelf(userId);
      }

      // Denormalized squad-visible rap sheet summary (server-written).
      match /rapSheet/{docId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create, update, delete: if false;
      }

      // Canonical score event stream (server-written).
      match /scoreEvents/{eventId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create, update, delete: if false;
      }

      // Daily score stats rollups (server-written).
      match /focusStats/{dayId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create, update, delete: if false;
      }

      // Persistent in-app notifications (server-written; user can only mark read state).
      match /notifications/{notificationId} {
        allow read: if isAdmin() || isSelf(userId);
        allow update: if isAdmin() || (isSelf(userId) && canMarkNotificationRead());
        allow create, delete: if false;
      }

      // Server-authoritative per-Commitment override authority.
      match /commitmentPolicies/{commitmentId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create, update, delete: if false;
      }
    }

    // Squad collaboration
    match /squads/{squadId} {
      allow create: if isAdmin() || (signedIn() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.memberIds is list &&
        request.resource.data.memberIds.size() == 1 &&
        request.resource.data.memberIds.hasOnly([request.auth.uid]));
      allow read: if isAdmin() || isCurrentSquadMember();

      // Membership changes are performed by callable functions. A client may
      // create its own one-member Circle, but cannot edit memberIds directly.
      allow update, delete: if isAdmin();

      // Sanitized Circle member projection. This document must never contain
      // email, fullName, FCM tokens, raw telemetry, or unrelated Commitments.
      match /members/{memberUid} {
        allow read: if isAdmin() || (signedIn() &&
          get(/databases/$(database)/documents/squads/$(squadId)).data.memberIds is list &&
          get(/databases/$(database)/documents/squads/$(squadId)).data.memberIds.hasAny([request.auth.uid]) &&
          resource.data.keys().hasOnly([
            'uid', 'displayName', 'avatarUrl', 'role', 'preset',
            'permissions', 'updatedAt'
          ]));
        allow create, update, delete: if false;
      }

      // Squad log (server-written audit trail)
      match /logs/{logId} {
        allow read: if isAdmin() || (signedIn() && currentUserSquadId() == squadId);
        allow create, update, delete: if false;
      }
    }

    // Plea creation/voting
    match /pleas/{pleaId} {
      // Plea documents are created/updated by Cloud Functions (Admin SDK), not by clients.
      allow create: if false;
      allow read: if isAdmin() || canAccessPleaData(resource.data) || isMockPlea(resource.data);
      allow update, delete: if false;

      // Session chat messages
      match /messages/{messageId} {
        allow read: if isAdmin() || (signedIn() &&
          (canAccessPleaData(get(/databases/$(database)/documents/pleas/$(pleaId)).data) ||
            isMockPlea(get(/databases/$(database)/documents/pleas/$(pleaId)).data)));

        // Client message writes are disabled; users and admins must use callables.
        allow create: if false;
        allow update, delete: if false;
      }

      // Canonical vote documents (server-only writes via callables/Admin SDK).
      match /votes/{voteUid} {
        allow read: if isAdmin() || (signedIn() &&
          (canAccessPleaData(get(/databases/$(database)/documents/pleas/$(pleaId)).data) ||
            isMockPlea(get(/databases/$(database)/documents/pleas/$(pleaId)).data)));
        allow create, update, delete: if false;
      }
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
